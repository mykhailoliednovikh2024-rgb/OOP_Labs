def get_avg_salary(salary_text):
    parts = salary_text.split('-')
    min_val = int(parts[0].replace('£', '').replace(',', '').strip())
    max_val = int(parts[1].replace('£', '').replace(',', '').strip())
    return (min_val + max_val) / 2

df['Avg_Salary'] = df['Salary Range'].apply(get_avg_salary)
df_sorted = df.sort_values(by='Avg_Salary', ascending=False)

print(df_sorted[['Job Title', 'Salary Range', 'Avg_Salary']].head(5))

