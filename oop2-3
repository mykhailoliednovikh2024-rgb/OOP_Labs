def get_max_salary(salary_text):
    if pd.isna(salary_text):
        return 0
    clean_text = str(salary_text).replace('£', '').replace(',', '')
    parts = clean_text.split('-')
    target = parts[1] if len(parts) > 1 else parts[0]
    return int(float(target.strip()))

def categorize_salary(salary):
    if salary <= 40000:
        return 'Low'
    elif 40001 <= salary <= 70000:
        return 'Medium'
    else:
        return 'High'

df['Max_Salary_Numeric'] = df['Salary Range'].apply(get_max_salary)
df['Salary Category'] = df['Max_Salary_Numeric'].apply(categorize_salary)

print(df[['Salary Range', 'Salary Category']].head(10))
